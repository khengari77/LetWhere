-- examples/03_turing_ackermann.lw
-- The Ackermann function demonstrates deep recursion.
-- A(m, n) = 
--   n + 1                  if m = 0
--   A(m - 1, 1)            if m > 0 and n = 0
--   A(m - 1, A(m, n - 1))  if m > 0 and n > 0

let ack = \m n ->
    if m == 0 
    then n + 1
    else if n == 0
         then ack (m - 1) 1
         else ack (m - 1) (ack m (n - 1))
in
    -- ack 3 4 results in 125
    ack 3 4
